<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Hot Button Footer Flow</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="showBack" type="Boolean" label="Show Back Button" default="false" />
            <property name="showNext" type="Boolean" label="Show Next Button" default="false" />
            <property name="showFinish" type="Boolean" label="Show Finish Button" default="false" />
            <property
                name="size"
                type="String"
                label="Button Size"
                description="Velg knappestørrelse: medium, small eller xsmall."
                default="medium"
            />
            <property name="backLabel" type="String" label="Back Button Label" default="Forrige" />
            <property name="nextLabel" type="String" label="Next Button Label" default="Neste" />
            <property name="finishLabel" type="String" label="Finish Button Label" default="Fullfør" />

        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>