<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>HOT Flow Wanted Resource Search</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="label" type="String" label="Label" />
            <property name="placeholder" type="String" label="Placeholder" default="Søk" />
            <property name="clearButton" type="Boolean" label="Show clear button" default="true" />
            <property name="searchFreelances" type="Boolean" label="Search Freelances" default="false" />
            <property name="searchEmployees" type="Boolean" label="Search Employees" default="false" />
            <property
                name="searchServiceProviderDispatcher"
                type="Boolean"
                label="Search Service Provider Dispatcher"
                default="false"
                description="When true, returns only service provider dispatchers. Search Employees and Search Freelances are ignored."
            />
            <property name="value" type="String" label="Search value" role="outputOnly" />
            <property name="recordId" type="String" label="Service Appointment Id" role="inputOnly" />
            <property
                name="excludedUserId"
                type="String"
                label="Excluded User Id"
                role="inputOnly"
                description="Exclude resources linked to this user."
            />
            <property name="required" type="Boolean" label="Require selection" default="false" role="inputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
