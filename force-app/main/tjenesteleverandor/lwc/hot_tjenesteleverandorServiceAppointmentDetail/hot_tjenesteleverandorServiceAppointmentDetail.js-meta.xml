<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>HOT - Tjenesteleverandør Service Appointment Detail</masterLabel>
    <description>Read-only Service Appointment details for tjenesteleverandør formidlere</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recordId"
                type="String"
                label="Service Appointment Record ID"
                description="Settes til {!recordId} på oppdragsdetaljsiden"
                default="{!recordId}"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
