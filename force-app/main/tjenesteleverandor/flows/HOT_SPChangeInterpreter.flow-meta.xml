    <decisions>
        <name>Can_Change_Interpreter</name>
        <label>Can Change Interpreter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NotAvailableScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Available</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4 AND 5 AND 6 AND 7</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Appointment.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Scheduled</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Service_Appointment.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Dispatched</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Service_Appointment.HOT_TjenesteleverandorStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Accepted</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_Assigned_Resource.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><elementReference>assignedResourceId</elementReference></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_Assigned_Resource.ServiceResourceId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><elementReference>originalServiceResourceId</elementReference></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_Assigned_Resource.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Service_Appointment.SchedEndTime</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><elementReference>$Flow.CurrentDateTime</elementReference></rightValue>
            </conditions>
            <connector>
                <targetReference>SelectInterpreterAndStatus</targetReference>
            </connector>
            <label>Allowed</label>
        </rules>
    </decisions>
