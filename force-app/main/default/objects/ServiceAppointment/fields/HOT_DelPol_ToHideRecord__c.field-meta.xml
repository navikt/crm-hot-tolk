<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>HOT_DelPol_ToHideRecord__c</fullName>
    <deprecated>false</deprecated>
    <formula>AND(
    NOT(
        HOT_DelPol_IsHideRecord__c
    ) ,
    Today() &gt; DateValue(DueDate + 3*365)
)</formula>
