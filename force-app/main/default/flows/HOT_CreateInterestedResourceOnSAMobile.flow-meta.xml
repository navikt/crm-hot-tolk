    <decisions>
        <name>Check_if_interested_resource_exists</name>
        <label>Check if interested resource exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Already_Registered_Interest_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already registered interest</defaultConnectorLabel>
        <rules>
            <name>No_existing_interested_resource_before_screen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Interested_Resource.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Registrer_Interesse_Screen</targetReference>
            </connector>
            <label>No existing interested resource before screen</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Service_Appointment_Status</name>
        <label>Check Service Appointment Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invalid_Service_Appointment_Status_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid service appointment status</defaultConnectorLabel>
        <rules>
            <name>Can_register_interest</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_SA.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>None</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_SA.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Released to Freelance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_SR</targetReference>
            </connector>
            <label>Can register interest</label>
        </rules>
    </decisions>
