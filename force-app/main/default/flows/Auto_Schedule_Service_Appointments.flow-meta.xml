    <environments>Default</environments>
    <formulas>
        <name>hasPreferredResource</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(NOT(ISBLANK({!preferredResource1Id})), NOT(ISBLANK({!preferredResource2Id}))), OR(NOT(ISBLANK({!Get_Request_record.Id})), NOT(ISBLANK({!Get_WorkOrder_record.Id}))))</expression>
    </formulas>
    <formulas>
        <name>hasWorkOrderStartAndEndDate</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Get_WorkOrder_record.StartDate})), NOT(ISBLANK({!Get_WorkOrder_record.EndDate})))</expression>
    </formulas>
    <formulas>
        <name>IsAutoDispatched</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!serviceappointment_checkbox_group}, {!Tildelt})</expression>
    </formulas>
    <formulas>
        <name>isAutoScheduleStatusValid</name>
        <dataType>Boolean</dataType>
        <expression>IF({!isWorkOrder}, TEXT({!Get_WorkOrder_record.HOT_Request__r.Status__c}) = &quot;Godkjent&quot;, TEXT({!Get_Request_record.Status__c}) = &quot;Godkjent&quot;)</expression>
    </formulas>
    <formulas>
        <name>isWorkOrder</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!recordId}, &quot;0WO&quot;)</expression>
    </formulas>
    <formulas>
        <name>noFreelanceInterpreterAvailable</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT({!isFreelanceInterpreterAvailable}), OR(ISBLANK({!preferredResource1Id}), {!isPreferredResource1Unavailable}), OR(ISBLANK({!preferredResource2Id}), {!isPreferredResource2Unavailable}), OR(NOT(ISBLANK({!preferredResource1Id})), NOT(ISBLANK({!preferredResource2Id}))))</expression>
    </formulas>
    <formulas>
        <name>parentRecordType</name>
        <dataType>String</dataType>
        <expression>IF({!isWorkOrder}, &quot;workOrder&quot;, &quot;request&quot;)</expression>
    </formulas>
    <formulas>
        <name>preferredResource1Id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Request_record.Id}), {!Get_WorkOrder_record.HOT_Request__r.PreferredResource1__c}, {!Get_Request_record.PreferredResource1__c})</expression>
    </formulas>
    <formulas>
        <name>preferredResource2Id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Request_record.Id}), {!Get_WorkOrder_record.HOT_Request__r.PreferredResource2__c}, {!Get_Request_record.PreferredResource2__c})</expression>
    </formulas>
