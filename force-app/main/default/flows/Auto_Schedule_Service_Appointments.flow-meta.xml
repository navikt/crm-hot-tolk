    <formulas>
        <name>hasPreferredResource</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(NOT(ISBLANK({!preferredResource1Id})), NOT(ISBLANK({!preferredResource2Id}))), OR(NOT(ISBLANK({!Get_Request_record.Id})), NOT(ISBLANK({!Get_WorkOrder_record.Id}))))</expression>
    </formulas>
    <formulas>
        <name>IsAutoDispatched</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!serviceappointment_checkbox_group}, {!Tildelt})</expression>
    </formulas>
    <formulas>
        <name>isWorkOrder</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!recordId}, &quot;0WO&quot;)</expression>
    </formulas>
    <formulas>
        <name>parentRecordType</name>
        <dataType>String</dataType>
        <expression>IF({!isWorkOrder}, &quot;workOrder&quot;, &quot;request&quot;)</expression>
    </formulas>
    <formulas>
        <name>preferredResource1Id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Request_record.Id}), {!Get_WorkOrder_record.HOT_Request__r.PreferredResource1__c}, {!Get_Request_record.PreferredResource1__c})</expression>
    </formulas>
    <formulas>
        <name>preferredResource2Id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Request_record.Id}), {!Get_WorkOrder_record.HOT_Request__r.PreferredResource2__c}, {!Get_Request_record.PreferredResource2__c})</expression>
    </formulas>
    <formulas>
        <name>Resource1WarningText</name>
        <dataType>String</dataType>
        <expression>&apos;Foretrukket ressurs 1 (&apos; &amp; {!Get_PreferredResource1_Resource.Name} &amp; &apos;) er opptatt i tidsrommet oppdraget er satt til: &apos; &amp; {!WorkOrderTimeRangeText} &amp; &apos;.&apos;</expression>
    </formulas>
    <formulas>
        <name>Resource2WarningText</name>
        <dataType>String</dataType>
        <expression>&apos;Foretrukket ressurs 2 (&apos; &amp; {!Get_PreferredResource2_Resource.Name} &amp; &apos;) er opptatt i tidsrommet oppdraget er satt til: &apos; &amp; {!WorkOrderTimeRangeText} &amp; &apos;.&apos;</expression>
    </formulas>
    <formulas>
        <name>WorkOrderTimeRangeText</name>
        <dataType>String</dataType>
        <expression>MID(TEXT({!Loop_WorkOrders.StartDate}), 9, 2) &amp; &apos;.&apos; &amp; MID(TEXT({!Loop_WorkOrders.StartDate}), 6, 2) &amp; &apos;.&apos; &amp; LEFT(TEXT({!Loop_WorkOrders.StartDate}), 4) &amp; &apos; &apos; &amp; MID(TEXT({!Loop_WorkOrders.StartDate}), 12, 5) &amp; &apos; - &apos; &amp; MID(TEXT({!Loop_WorkOrders.EndDate}), 12, 5)</expression>
    </formulas>
